[Unit]
Description=Detection marche/arret machine (5 dernieres minutes du DVR)
After=network-online.target
Wants=network-online.target

[Service]
# Type=oneshot : le script analyse une fenetre puis rend la main. C'est le
# timer qui le rappelle, pas une boucle interne — un plantage n'arrete donc
# jamais la mesure, le tour suivant repart proprement.
Type=oneshot
User=mbelkhayat
WorkingDirectory=/home/mbelkhayat/suivi-de-machine
ExecStart=/home/mbelkhayat/suivi-de-machine/.venv/bin/python3 machine_etat/detecter_marche_arret.py
# Correctif du 2026-10-01 : en pratique, lire + comparer 5 min de video prend
# environ 6,5 min (le Jetson est plus lent que le temps reel pour ce calcul,
# le flou ajoute encore un peu de travail par image) — PAS "bien moins que 5
# minutes" comme le disait ce commentaire avant verification. 480s laisse une
# marge au-dela de ces ~6,5 min observees ; en dessous, le tour est tue avant
# d'avoir fini, pour rien (voir PLAFOND_RATTRAPAGE_MINUTES dans le script :
# il ne tente jamais plus de 5 minutes de video par passage, justement pour
# rester sous ce delai).
TimeoutStartSec=480

[Install]
WantedBy=multi-user.target
