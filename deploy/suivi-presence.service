[Unit]
Description=Suivi de presence machine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mbelkhayat
WorkingDirectory=/home/mbelkhayat/suivi-de-machine
ExecStart=/home/mbelkhayat/suivi-de-machine/.venv/bin/python3 main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
