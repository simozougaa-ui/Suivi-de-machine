# Copier ce fichier vers .env et renseigner les valeurs réelles.
# Ne jamais committer le fichier .env (identifiants réels) dans le dépôt.
#
# DVR Dahua : CAMERA_CHANNEL est le numéro de canal tel qu'affiché dans
# l'appli DMSS (ex: 15), pas un numéro de flux Hikvision.

DVR_IP=
DVR_USER=
DVR_PASSWORD=
DVR_PORT=554
CAMERA_CHANNEL=

# Nom affiché dans le tableau de bord et les sessions enregistrées.
MACHINE_NAME=Machine 1

# Méthode de détection de présence : fragments (défaut, voir
# src/fragment_detection.py) | yolo (personne entière) | both (l'un OU
# l'autre). Laisser vide = fragments.
PRESENCE_MODE=fragments

# Secondes d'absence continue avant de clôturer une session (défaut 30 —
# les allers-retours/masquages du conducteur durent souvent 6 à 20s).
ABSENCE_TOLERANCE_SECONDS=30
