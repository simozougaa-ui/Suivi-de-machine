[Unit]
Description=Lance la detection marche/arret toutes les 5 minutes

[Timer]
# Toutes les 5 minutes, calees sur l'horloge (00, 05, 10...). Le script analyse
# la fenetre [T-10min, T-5min] : le DVR a donc fini d'ecrire ce qu'on relit.
OnCalendar=*:0/5
# Si le Jetson etait eteint au moment prevu, on rattrape au demarrage plutot
# que d'attendre le prochain quart d'heure.
Persistent=true
AccuracySec=10s

[Install]
WantedBy=timers.target
